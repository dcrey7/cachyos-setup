From 4e458eb37731a510cdd3fca5fe8439466b5c01fb Mon Sep 17 00:00:00 2001
From: Abhishek <abhishek01789@gmail.com>
Date: Sun, 11 Oct 2026 15:52:04 +0200
Subject: [PATCH 05/33] Split tiles evenly up to 3 columns and follow the KDE
 dark theme

---
 packages/config/src/index.tsx         |  3 ++-
 packages/config/src/window-manager.ts | 12 ++++++++++--
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/packages/config/src/index.tsx b/packages/config/src/index.tsx
index 175b1a3..1c35e79 100644
--- a/packages/config/src/index.tsx
+++ b/packages/config/src/index.tsx
@@ -53,7 +53,8 @@ import { createWindowGrid } from "./window-grid";
 
 COMPOSITOR.env.apply({
   QT_QPA_PLATFORM: "wayland;xcb",
-  QT_QPA_PLATFORMTHEME: "qt6ct",
+  // Follow the KDE theme (Breeze dark) instead of qt6ct.
+  QT_QPA_PLATFORMTHEME: "kde",
   QT_IM_MODULE: "fcitx",
   XMODIFIERS: "@im=fcitx",
   SDL_IM_MODULE: "fcitx",
diff --git a/packages/config/src/window-manager.ts b/packages/config/src/window-manager.ts
index 24e0c49..1aebde3 100644
--- a/packages/config/src/window-manager.ts
+++ b/packages/config/src/window-manager.ts
@@ -161,7 +161,7 @@ const TILE_DRAG_WORKSPACE_EDGE_PX = 80;
 const TILE_DRAG_WORKSPACE_SWITCH_INTERVAL_MS = 420;
 const TILE_GAP = 12;
 const TILE_MARGIN = 12;
-const TILE_WIDTH_RATIO = 0.5;
+const TILE_FIT_MAX_COLUMNS = 3;
 const TILE_MIN_WIDTH = 240;
 // Fractional-scale rounding can leave a tile a hair past the screen edge;
 // overflow at or below this is "fully visible" for the focus-key pan step.
@@ -5468,9 +5468,17 @@ export class Workspace {
   }
 
   private defaultTileWidth(viewportRect: ManagedWindowRect): number {
+    // Up to TILE_FIT_MAX_COLUMNS windows share the screen evenly, so no
+    // window is cut at the edge. More windows scroll at that column width.
+    const columns = clamp(
+      this.tileableWindows().length,
+      1,
+      TILE_FIT_MAX_COLUMNS,
+    );
+    const gaps = TILE_GAP * (columns - 1);
     return Math.max(
       TILE_MIN_WIDTH,
-      read(viewportRect.width) * TILE_WIDTH_RATIO,
+      (read(viewportRect.width) - gaps) / columns,
     );
   }
 
