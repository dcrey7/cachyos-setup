From 1653662bc766c00b7b38c91990f8894924d6734e Mon Sep 17 00:00:00 2001
From: Abhishek <abhishek01789@gmail.com>
Date: Sun, 11 Oct 2026 23:36:42 +0200
Subject: [PATCH 38/40] Grid: traffic lights on the hovered card close,
 maximize and minimize

---
 packages/config/src/index.tsx       | 10 ++++++----
 packages/config/src/window-grid.tsx | 15 ++++++++-------
 2 files changed, 14 insertions(+), 11 deletions(-)

diff --git a/packages/config/src/index.tsx b/packages/config/src/index.tsx
index 6861dd6..b825107 100644
--- a/packages/config/src/index.tsx
+++ b/packages/config/src/index.tsx
@@ -190,6 +190,7 @@ const WINDOW_GRID = createWindowGrid({
     window.state[WINDOW_STATE_FULLSCREEN]()
       ? FULLSCREEN_Z_INDEX
       : windowZIndex(window),
+  titlebarButtonAt: (window, x, y) => titlebarButtonAt(window, x, y),
 });
 COMPOSITOR.rendering.composition = (output) =>
   WINDOW_SWITCHER.compose(output) ??
@@ -1854,13 +1855,14 @@ const TRAFFIC_LIGHT_SIZE = 12;
 const TITLEBAR_PADDING_X = 8;
 const TITLEBAR_GAP = 8;
 
-/** The window is the hovered card of the Window View. */
+/** The window is the hovered card of the Window View or the grid. */
 const isWindowViewCard = (window: WaylandWindow) =>
-  WINDOW_VIEW.selectedWindowId() === window.id;
+  WINDOW_VIEW.selectedWindowId() === window.id ||
+  WINDOW_GRID.selectedWindowId() === window.id;
 
-/** While the Window View is open, only its hovered card shows traffic lights. */
+/** While the Window View or the grid is open, only its hovered card shows traffic lights. */
 const trafficLightsShown = (window: WaylandWindow) =>
-  !WINDOW_VIEW.isOpen() || isWindowViewCard(window);
+  (!WINDOW_VIEW.isOpen() && !WINDOW_GRID.isOpen()) || isWindowViewCard(window);
 
 /**
  * The traffic light at `(x, y)`, logical px from the top-left corner of
diff --git a/packages/config/src/window-grid.tsx b/packages/config/src/window-grid.tsx
index ee63a0b..7770eda 100644
--- a/packages/config/src/window-grid.tsx
+++ b/packages/config/src/window-grid.tsx
@@ -147,6 +147,14 @@ const WINDOW_GRID_LAYOUT: SwitcherLayout<GridState> = {
   },
 
   onClickOutside: (_state, controls) => controls.cancel(),
+
+  // The hovered card's title bar buttons work; a minimized window stays as a
+  // dimmed card (KWin shows it at full opacity; dimmed by request).
+  cardActions: true,
+  minimizedOpacity: 0.5,
+  windowsChanged: (state) => {
+    state.cellsKey = "";
+  },
 };
 
 const WINDOW_VIEW_LAYOUT: SwitcherLayout<GridState> = {
@@ -158,13 +166,6 @@ const WINDOW_VIEW_LAYOUT: SwitcherLayout<GridState> = {
   initialSelection: () => 0,
   // Opened by a click, not by a held key.
   onSuperReleased: () => {},
-  // The hovered card's title bar buttons work; a minimized window stays as a
-  // dimmed card (KWin shows it at full opacity; dimmed by request).
-  cardActions: true,
-  minimizedOpacity: 0.5,
-  windowsChanged: (state) => {
-    state.cellsKey = "";
-  },
 };
 
 /** The window in the row above (`-1`) or below (`1`) nearest the selection. */
