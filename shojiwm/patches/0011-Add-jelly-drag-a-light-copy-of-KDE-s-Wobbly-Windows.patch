From 8d63c692da4dd84c0aa8bfe53e8a7f5d21365954 Mon Sep 17 00:00:00 2001
From: Abhishek <abhishek01789@gmail.com>
Date: Sun, 11 Oct 2026 16:46:19 +0200
Subject: [PATCH 11/33] Add jelly drag, a light copy of KDE's Wobbly Windows

While a window is dragged, a spring makes its far side trail the pointer
and wobble back on release; a shader shifts the pixels. The effect
exists only while a window moves or settles. Untested: the nested
preview does not draw window replace effects. JELLY_DRAG turns it off.
---
 packages/config/src/effect/jelly-drag.frag |  22 +++
 packages/config/src/index.tsx              |  16 +-
 packages/config/src/jelly-drag.ts          | 180 +++++++++++++++++++++
 3 files changed, 217 insertions(+), 1 deletion(-)
 create mode 100644 packages/config/src/effect/jelly-drag.frag
 create mode 100644 packages/config/src/jelly-drag.ts

diff --git a/packages/config/src/effect/jelly-drag.frag b/packages/config/src/effect/jelly-drag.frag
new file mode 100644
index 0000000..dc316bd
--- /dev/null
+++ b/packages/config/src/effect/jelly-drag.frag
@@ -0,0 +1,22 @@
+uniform vec2 lag_px;   // how far the far side trails the window, logical px
+uniform vec2 grab_px;  // the grabbed point, logical px from the window's top-left
+
+// Jelly drag: shifts each pixel by the spring lag, more the farther it is from
+// the grabbed point. The grabbed point stays under the pointer; the far side
+// trails behind and wobbles back.
+vec4 shader_main(EffectContext effect) {
+    vec2 grab = grab_px * effect.scale;
+    vec2 size = effect.frame_rect_phy_px.zw;
+
+    // Full lag at the corner farthest from the grabbed point, none at it.
+    float reach = max(length(max(grab, size - grab)), 1.0);
+    float weight = clamp(length(effect_frame_phy_px(effect) - grab) / reach, 0.0, 1.0);
+    weight = weight * weight * (3.0 - 2.0 * weight);
+
+    vec2 sample_px = effect_texture_phy_px(effect) - lag_px * effect.scale * weight;
+    vec2 uv = sample_px / effect.texture_size_phy_px;
+    if (uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) {
+        return vec4(0.0);
+    }
+    return texture2D(tex, uv);
+}
