       } else {
         const start = session.startPoses.get(window.id);
         const from = start ?? { ...shown, z: shown.z - fadeDepth(viewport.height, 0.3), opacity: 0 };
-        pose = session.phase === "entering" ? lerpPose(from, shown, eased) : shown;
+        pose =
