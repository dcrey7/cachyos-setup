 packages/config/src/index.tsx           | 20 ++++++++----
 packages/config/src/window-switcher.tsx | 17 +++++++---
 3 files changed, 70 insertions(+), 10 deletions(-)

diff --git a/packages/config/src/coverflow.tsx b/packages/config/src/coverflow.tsx
